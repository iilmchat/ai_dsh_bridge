# AI DSH Bridge
PORT=3456
DEBUG_DIR=~/.ai-dsh-bridge/debug
DEBUG=0
DEEPSEEK_BASE_URL=https://chat.deepseek.com
AUTH_FILE=~/.ai-dsh-bridge/auth.json
LOG_LEVEL=info

# Google Gemini API (опционально): ключ Google AI Studio.
# Модели google-gemini-api-flash / google-gemini-api-pro.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Google Gemini Web (опционально): cookie-сессия после `pnpm webauth:google`.
# Модель google-gemini-web.
GEMINI_WEB_BASE_URL=https://gemini.google.com
GOOGLE_AUTH_FILE=~/.ai-dsh-bridge/google-auth.json

# Таймаут запросов к Google, мс.
GEMINI_TIMEOUT_MS=120000

# WAF (опционально; если пусто — не отправляем заголовки x-hif-*)
DEEPSEEK_WAF_DLIQ=
DEEPSEEK_WAF_LEIM=
